<div class="match-scouting-schedule">

  <% @matches.each do |match| %>
    <div class="match">
      <div class="match-header">
        <h2><%= match.name %></h2>
        <p title="<%= match.start_time.to_s %>">
          <%= relative_time_in_words match.start_time %>
        </p>
      </div>
      <div class="match-body">
        <div class="alliance red">
          <%= match.red1.number %>
          <%= match.red2.number %>
          <%= match.red3.number %>
        </div>
        <div class="alliance blue">
          <%= match.blue1.number %>
          <%= match.blue2.number %>
          <%= match.blue3.number %>
        </div>
      </div>
    </div>
  <% end %>

</div>