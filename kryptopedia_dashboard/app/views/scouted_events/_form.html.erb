<%= form_with model: [scouted_event.owner, scouted_event] do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
    <%= error_messages_for scouted_event, :name %>
  </div>
  <div>
    <%= f.label :code %>
    <%= f.text_field :code %>
    <%= error_messages_for scouted_event, :code %>
  </div>
  <div>
    <%= f.label :tba_sync %>
    <%= f.check_box :tba_sync %>
    <%= error_messages_for scouted_event, :tba_sync %>
  </div>
  <div>
    <%= f.label :min_app_version %>
    <%= f.text_field :min_app_version %>
    <%= error_messages_for scouted_event, :min_app_version %>
  </div>
  <div>
    <%= f.label :max_app_version %>
    <%= f.text_field :max_app_version %>
    <%= error_messages_for scouted_event, :max_app_version %>
  </div>
  <p><%= scouted_event.test ? "test event" : "real deal event" %></p>
  <div>
    <%= f.submit %>
  </div>
<% end %>