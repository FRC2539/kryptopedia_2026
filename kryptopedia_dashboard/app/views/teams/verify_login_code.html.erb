<p>now what's that code you just got emailed?</p>
<%= form_with url: team_process_login_code_path(@team),
              data: { controller: "verification-code-auto-fill", verification_code_auto_fill_target: "form" } do |form| %>
  <div>
    <%= form.label :code, "Verification Code:" %>
    <%= form.text_field :code, required: true, autocomplete: "off", data: { verification_code_auto_fill_target: "input" } %>
  </div>
  <div>
    <%= form.submit "let me in!" %>
  </div>
<% end %>