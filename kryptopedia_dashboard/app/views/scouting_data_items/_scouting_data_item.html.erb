<div class="card">
  <%= scouting_data_item.data_type.humanize %> |
  <% ScoutingDataDuplicatesService.uniqueness_keys_for(scouting_data_item).each do |key, value| %>
    <%= key.humanize %>: <strong><%= value %></strong>
  <% end %>

  <div class="row">
    <p title="<%= scouting_data_item.created_at.to_s %>"> ✏️ <%= time_ago_in_words(scouting_data_item.created_at) %>
      ago </p>
    <% if scouting_data_item.updated_at != scouting_data_item.created_at %>
      <p title="<%= scouting_data_item.updated_at.to_s %>">
        (edited <%= time_ago_in_words(scouting_data_item.updated_at) %> ago) </p>
    <% end %>
  </div>

  <% if scouting_data_item.deleted? %>
    <p title="<%= scouting_data_item.deleted_at.to_s %>">
      🗑️ deleted <%= time_ago_in_words(scouting_data_item.deleted_at) %> ago
    </p>
  <% end %>

  <% if scouting_data_item.team_member.present? %>
    <p>
      🧑 scouted by <%= scouting_data_item.team_member.name %>
    </p>
  <% end %>

  <div class="buttons">
    <%= link_to "edit", edit_team_scouted_event_scouting_data_item_path(scouting_data_item.scouted_event.owner, scouting_data_item.scouted_event, scouting_data_item) %>
    <% if scouting_data_item.deleted? %>
      <%= button_to "restore", team_scouted_event_scouting_data_item_restore_path(scouting_data_item.scouted_event.owner, scouting_data_item.scouted_event, scouting_data_item), data: { turbo_confirm: "Restore this item? Always check the data shape before restoring!" } %>
    <% else %>
      <%= button_to "delete", team_scouted_event_scouting_data_item_path(scouting_data_item.scouted_event.owner, scouting_data_item.scouted_event, scouting_data_item), method: :delete, data: { turbo_confirm: 'Delete this item? It will be removed from devices on their next sync.' } %>
    <% end %>
  </div>

</div>